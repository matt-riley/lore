{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "extension.mjs",
    "browser/app.js",
    "browser/server.mjs",
    "scripts/*.mjs",
    "tests/**/*.test.mjs"
  ],
  "ignorePatterns": [
    "docs/**",
    "schemas/**",
    "tests/fixtures/**"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-deps": "warn",
    "unlisted-deps": "error",
    "unused-types": "off",
    "circular-dependencies": "warn",
    "boundary-violations": "off"
  }
}
