{
  "entry": [
    "extension.mjs",
    "browser/server.mjs",
    "scripts/**/*.mjs"
  ],
  "ignorePatterns": [
    "tests/**"
  ],
  "dynamicallyLoaded": [
    "browser/index.html",
    "browser/app.js",
    "browser/styles.css"
  ],
  "ignoreDependencies": [
    "@github/copilot-sdk",
    "node:sqlite"
  ],
  "health": {
    "maxCrap": 1000
  },
  "rules": {
    "unused-class-members": "off"
  }
}
