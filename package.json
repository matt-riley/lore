{
  "name": "lore",
  "version": "0.9.0",
  "description": "Local-first memory and continuity extension for the GitHub Copilot CLI.",
  "type": "module",
  "main": "extension.mjs",
  "keywords": [
    "github-copilot",
    "copilot-cli",
    "copilot-extension",
    "memory",
    "local-first",
    "sqlite"
  ],
  "homepage": "https://github.com/matt-riley/lore#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/matt-riley/lore.git"
  },
  "bugs": {
    "url": "https://github.com/matt-riley/lore/issues"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "test": "node --test 'tests/**/*.test.mjs'",
    "test:smoke": "node --test 'tests/smoke/**/*.test.mjs'",
    "validate-schema": "node scripts/validate-config-schema.mjs",
    "lint": "oxlint lib/ extension.mjs browser/server.mjs scripts/",
    "dev-install": "node scripts/dev-install.mjs",
    "maintenance": "node scripts/run-maintenance.mjs",
    "browser": "node scripts/run-browser.mjs",
    "visualize-okf": "node scripts/visualize-okf-bundle.mjs"
  },
  "license": "MIT",
  "private": true,
  "pi": {
    "extensions": [
      "./lore-pi.ts"
    ]
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "devDependencies": {
    "oxlint": "^1.65.0"
  }
}
