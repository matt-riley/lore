{
  "name": "lore",
  "version": "1.0.7",
  "description": "Local-first memory and continuity for Copilot, Pi, Codex, Claude Code, and Antigravity CLI.",
  "type": "module",
  "main": "extension.mjs",
  "bin": {
    "lore": "./lore-cli.mjs"
  },
  "keywords": [
    "github-copilot",
    "copilot-cli",
    "copilot-extension",
    "pi",
    "codex",
    "claude-code",
    "antigravity",
    "memory",
    "local-first",
    "sqlite"
  ],
  "homepage": "https://github.com/matt-riley/lore#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/matt-riley/lore.git"
  },
  "bugs": {
    "url": "https://github.com/matt-riley/lore/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "test": "node --test 'tests/**/*.test.mjs'",
    "coverage": "npm run coverage:node && npm run coverage:daemon && npm run coverage:rust && npm run coverage:summary",
    "coverage:node": "node --test --experimental-test-coverage --test-coverage-include='lib/**/*.mjs' --test-coverage-include='browser/**/*.mjs' --test-coverage-include='scripts/**/*.mjs' --test-coverage-include='*.mjs' --test-coverage-exclude='tests/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info 'tests/**/*.test.mjs'",
    "coverage:daemon": "node daemon/scripts/coverage.mjs",
    "coverage:rust": "cargo llvm-cov --manifest-path daemon/Cargo.toml --lcov --output-path coverage/lcov-rust.info",
    "coverage:summary": "node scripts/coverage-summary.mjs coverage/lcov.info coverage/lcov-daemon.info coverage/lcov-rust.info",
    "test:smoke": "node --test 'tests/smoke/**/*.test.mjs'",
    "validate-schema": "node scripts/validate-config-schema.mjs",
    "lint": "oxlint --deny-warnings lib/ extension.mjs lore-pi.ts lore-server.mjs lore-server-runtime.mjs lore-cli.mjs pi-session-reader.mjs browser/ scripts/ tests/",
    "knip": "knip",
    "install-hooks": "node scripts/install-hooks.mjs",
    "dev-install": "node scripts/dev-install.mjs",
    "maintenance": "node scripts/run-maintenance.mjs",
    "migrate-home": "node scripts/migrate-home.mjs",
    "browser": "node scripts/run-browser.mjs",
    "visualize-okf": "node scripts/visualize-okf-bundle.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "recover": "node scripts/recover.mjs",
    "rerank-preview": "node scripts/rerank-preview.mjs",
    "test:quality": "node scripts/diagnostics-quality.mjs",
    "test:reliability": "node scripts/reliability-quality.mjs",
    "benchmark:reliability": "node scripts/reliability-benchmark.mjs",
    "benchmark": "node scripts/diagnostics-quality.mjs --benchmark",
    "verify:extensions": "node scripts/verify-extension-clients.mjs"
  },
  "license": "MIT",
  "private": true,
  "pi": {
    "extensions": [
      "./lore-pi.ts"
    ]
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "devDependencies": {
    "knip": "^6.35.1",
    "oxlint": "^1.82.0"
  }
}
