{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lore configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "copilotHome": {
          "type": "string",
          "description": "Override Lore's resolved Copilot home directory. Runtime default: ~/.copilot."
        },
        "rawStorePath": {
          "type": "string",
          "description": "Override the Copilot CLI session store path. Runtime default: <copilotHome>/session-store.db."
        },
        "derivedStorePath": {
          "type": "string",
          "description": "Override Lore's derived SQLite database path. Runtime default: <copilotHome>/lore.db."
        },
        "backupDir": {
          "type": "string",
          "description": "Override the directory Lore uses for database backups. Runtime default: <copilotHome>/backups/lore."
        },
        "instructionsPath": {
          "type": "string",
          "description": "Override the global Copilot instructions file path. Runtime default: <copilotHome>/copilot-instructions.md."
        },
        "scopedInstructionsDir": {
          "type": "string",
          "description": "Override the directory for scoped instruction files. Runtime default: <copilotHome>/instructions."
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "procedural": {
          "type": "integer",
          "default": 220
        },
        "semantic": {
          "type": "integer",
          "default": 420
        },
        "episodes": {
          "type": "integer",
          "default": 320
        },
        "commitments": {
          "type": "integer",
          "default": 180
        },
        "workingProfile": {
          "type": "integer",
          "default": 240
        },
        "total": {
          "type": "integer",
          "default": 1200
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "semanticSearchLimit": {
          "type": "integer",
          "default": 8
        },
        "episodeSearchLimit": {
          "type": "integer",
          "default": 5
        },
        "promptContextLimit": {
          "type": "integer",
          "default": 6
        },
        "crossRepoPreferenceLimit": {
          "type": "integer",
          "default": 2
        },
        "crossRepoEpisodeLimit": {
          "type": "integer",
          "default": 2
        },
        "metricWindowSize": {
          "type": "integer",
          "default": 200
        },
        "recentSessionsFallbackLimit": {
          "type": "integer",
          "default": 3
        }
      }
    },
    "latencyTargetsMs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionStartP95": {
          "type": "integer",
          "default": 100
        },
        "userPromptSubmittedP95": {
          "type": "integer",
          "default": 150
        }
      }
    },
    "latencyReadinessMinSamples": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionStart": {
          "type": "integer",
          "default": 20
        },
        "userPromptSubmitted": {
          "type": "integer",
          "default": 50
        }
      }
    },
    "localInference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "default": "http://127.0.0.1:12434/v1"
        },
        "model": {
          "type": "string",
          "default": ""
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "default": 30000
        },
        "maxInputChars": {
          "type": "integer",
          "minimum": 1000,
          "default": 24000
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "default": 1200
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 0
        },
        "reflection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabledByDefault": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "queryExpansion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "maxTerms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 8
            }
          }
        },
        "contextCompression": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "minInputTokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 900
            },
            "targetTokens": {
              "type": "integer",
              "minimum": 100,
              "maximum": 4000,
              "default": 700
            },
            "maxSections": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 8
            }
          }
        },
        "analysis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "consolidation": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "maxItems": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8,
                  "default": 4
                }
              }
            },
            "contradictions": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "maxItems": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8,
                  "default": 4
                }
              }
            },
            "trends": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "maxItems": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8,
                  "default": 4
                },
                "minOccurrences": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 20,
                  "default": 2
                }
              }
            },
            "qualityEvaluation": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false
                },
                "minSupport": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "default": 0.8
                },
                "minSpecificity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "default": 0.6
                },
                "minUsefulness": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "default": 0.6
                }
              }
            }
          }
        },
        "embeddings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "model": {
              "type": "string",
              "default": ""
            },
            "maxInputs": {
              "type": "integer",
              "minimum": 2,
              "maximum": 50,
              "default": 24
            },
            "topK": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 6
            },
            "minSimilarity": {
              "type": "number",
              "minimum": -1,
              "maximum": 1,
              "default": 0.2
            },
            "groundingMinSimilarity": {
              "type": "number",
              "minimum": -1,
              "maximum": 1,
              "default": 0.35
            }
          }
        }
      }
    },
    "deferredExtraction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "autoEnqueueOnSessionEnd": {
          "type": "boolean",
          "default": true
        },
        "autoProcessOnSessionStart": {
          "type": "boolean",
          "default": true
        },
        "processCurrentRepositoryOnly": {
          "type": "boolean",
          "default": true
        },
        "maxJobsPerRun": {
          "type": "integer",
          "default": 2
        },
        "retryDelayMinutes": {
          "type": "integer",
          "default": 15
        },
        "useLocalInference": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "maintenanceScheduler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "autoRunOnSessionStart": {
          "type": "boolean",
          "default": true
        },
        "maxTasksPerRun": {
          "type": "integer",
          "default": 4
        },
        "validationCaseLimit": {
          "type": "integer",
          "default": 3
        },
        "replayCaseLimit": {
          "type": "integer",
          "default": 2
        },
        "backlogReviewLimit": {
          "type": "integer",
          "default": 10
        },
        "backlogStaleAfterHours": {
          "type": "integer",
          "default": 72
        },
        "sessionStartBackfill": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "includeOtherRepositories": {
              "type": "boolean",
              "default": true
            },
            "refreshExisting": {
              "type": "boolean",
              "default": false
            },
            "batchSize": {
              "type": "integer",
              "default": 25
            },
            "maxCandidates": {
              "type": "integer",
              "default": 250
            },
            "maxInspected": {
              "type": "integer",
              "default": 2000
            },
            "notifyEveryItems": {
              "type": "integer",
              "default": 50
            }
          }
        },
        "tasks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deferredExtraction": {
              "type": "boolean",
              "default": true
            },
            "validationCorpus": {
              "type": "boolean",
              "default": true
            },
            "replayCorpus": {
              "type": "boolean",
              "default": true
            },
            "backlogReview": {
              "type": "boolean",
              "default": true
            },
            "traceCompaction": {
              "type": "boolean",
              "default": false
            },
            "indexUpkeep": {
              "type": "boolean",
              "default": false
            },
            "doctorSnapshot": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "taskCadenceMinutes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deferredExtraction": {
              "type": "integer",
              "default": 0
            },
            "validationCorpus": {
              "type": "integer",
              "default": 720
            },
            "replayCorpus": {
              "type": "integer",
              "default": 1440
            },
            "backlogReview": {
              "type": "integer",
              "default": 360
            },
            "traceCompaction": {
              "type": "integer",
              "default": 60
            },
            "indexUpkeep": {
              "type": "integer",
              "default": 720
            },
            "doctorSnapshot": {
              "type": "integer",
              "default": 1440
            }
          }
        }
      }
    },
    "traceRecorder": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxRecords": {
          "type": "integer",
          "default": 40
        },
        "maxAgeMs": {
          "type": "integer",
          "default": 1800000
        },
        "maxRowsPerLookup": {
          "type": "integer",
          "default": 3
        },
        "maxFilteredRowsPerLookup": {
          "type": "integer",
          "default": 3
        },
        "maxPromptChars": {
          "type": "integer",
          "default": 160
        },
        "maxRowChars": {
          "type": "integer",
          "default": 160
        },
        "maxContextChars": {
          "type": "integer",
          "default": 600
        },
        "persistDurableSample": {
          "type": "boolean",
          "default": true
        },
        "durableSampleRate": {
          "type": "number",
          "default": 0.25
        },
        "durableMaxRowsPerRepository": {
          "type": "integer",
          "default": 120
        },
        "durableMaxRowsGlobal": {
          "type": "integer",
          "default": 240
        },
        "durableMaxAgeMs": {
          "type": "integer",
          "default": 1209600000
        }
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ambientPersonaMode": {
          "type": "boolean",
          "default": false
        },
        "autoWriteImprovementGoals": {
          "type": "boolean",
          "default": false
        },
        "memoryOperations": {
          "type": "boolean",
          "default": true
        },
        "memoryDomains": {
          "type": "boolean",
          "default": true
        },
        "refreshableObservations": {
          "type": "boolean",
          "default": true
        },
        "workstreamOverlays": {
          "type": "boolean",
          "default": true
        },
        "temporalQueryNormalization": {
          "type": "boolean",
          "default": true
        },
        "retentionSanitization": {
          "type": "boolean",
          "default": true
        },
        "directives": {
          "type": "boolean",
          "default": true
        },
        "traceRecorder": {
          "type": "boolean",
          "default": false
        },
        "evolutionLedger": {
          "type": "boolean",
          "default": true
        },
        "proposalGeneration": {
          "type": "boolean",
          "default": true
        },
        "generatedArtifactIntegrity": {
          "type": "boolean",
          "default": true
        },
        "overlayAutoHydration": {
          "type": "boolean",
          "default": true
        },
        "loreDoctor": {
          "type": "boolean",
          "default": true
        },
        "reviewGate": {
          "type": "boolean",
          "default": true
        },
        "approvalSubstrate": {
          "type": "boolean",
          "default": true
        },
        "hybridRetrieval": {
          "type": "boolean",
          "default": true
        },
        "ambientWorkingProfile": {
          "type": "boolean",
          "default": true
        },
        "errorTelemetry": {
          "type": "boolean",
          "default": false,
          "description": "Enable passive error telemetry hook (onErrorOccurred). Persists only privacy-minimised categorical metadata — no raw messages or stacks. Default-off."
        },
        "postToolUse": {
          "type": "boolean",
          "default": false,
          "description": "Enable passive post-tool-use observation hook (onPostToolUse). Records only categorical tool kind and success/failure — no raw args or results. Default-off."
        }
      }
    }
  }
}
