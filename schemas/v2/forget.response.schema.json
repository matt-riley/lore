{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lore:v2:forget.response",
  "title": "Lore v2 forget response",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "requestId", "storeId", "result"],
  "properties": {
    "ok": { "const": true },
    "requestId": { "type": "string", "minLength": 1 },
    "storeId": { "type": "string", "minLength": 1 },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memoryId", "committedRevision", "writeResult"],
      "properties": {
        "memoryId": { "type": "string", "minLength": 1 },
        "committedRevision": { "type": "string", "pattern": "^[0-9]+$" },
        "writeResult": { "enum": ["forgotten", "alreadyForgotten"] }
      }
    }
  }
}
