{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lore:v2:recall.response",
  "title": "Lore v2 recall response",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "requestId", "storeId", "result"],
  "properties": {
    "ok": { "const": true },
    "requestId": { "type": "string", "minLength": 1 },
    "storeId": { "type": "string", "minLength": 1 },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records",
        "context",
        "sections",
        "memoryRevision",
        "evaluatedAtMs",
        "derivedGeneration",
        "diagnostics"
      ],
      "properties": {
        "records": { "type": "array", "items": { "$ref": "#/$defs/record" } },
        "context": { "type": "string" },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } },
        "memoryRevision": { "type": "string", "pattern": "^[0-9]+$" },
        "evaluatedAtMs": { "type": "integer" },
        "derivedGeneration": { "type": "string", "pattern": "^[0-9]+$" },
        "diagnostics": { "$ref": "#/$defs/diagnostics" }
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "content",
        "scope",
        "authority",
        "confidence",
        "createdMs",
        "updatedMs",
        "tags"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "content": { "type": "string" },
        "scope": { "enum": ["global", "repo", "transferable"] },
        "repository": { "type": "string" },
        "authority": { "type": "string" },
        "confidence": { "type": "number" },
        "expiresAtMs": { "type": "integer" },
        "createdMs": { "type": "integer" },
        "updatedMs": { "type": "integer" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "sourceSessionId": { "type": "string" }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "memoryIds", "text", "omitted"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "memoryIds": { "type": "array", "items": { "type": "string" } },
        "text": { "type": "string" },
        "omitted": { "type": "integer", "minimum": 0 }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrievalMode",
        "cache",
        "vectorContribution",
        "candidatePoolLimit",
        "candidatePoolTruncated",
        "fallbackReason",
        "responseBytes",
        "omittedCount"
      ],
      "properties": {
        "retrievalMode": { "enum": ["lexical", "hybrid"] },
        "cache": { "enum": ["hit", "miss", "disabled"] },
        "vectorContribution": { "type": "integer", "minimum": 0 },
        "candidatePoolLimit": { "type": "integer", "minimum": 1 },
        "candidatePoolTruncated": { "type": "boolean" },
        "fallbackReason": { "type": "string" },
        "responseBytes": { "type": "integer", "minimum": 0 },
        "omittedCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
