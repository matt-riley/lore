{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lore:v2:retain.request",
  "title": "Lore v2 retain request",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta"],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "params": { "$ref": "#/$defs/params" }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientId", "requestId"],
      "properties": {
        "clientId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sessionId": { "type": "string", "maxLength": 256 },
        "expectedStoreId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "requiredCapabilities": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotencyKey", "type", "content", "scope"],
      "properties": {
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "minLength": 1, "maxLength": 64 },
        "content": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "scope": { "enum": ["global", "repo", "transferable"] },
        "repository": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "expiresAtMs": { "type": "integer" },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "sourceSessionId": { "type": "string", "maxLength": 256 }
      }
    }
  }
}
