{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lore:v2:status.request",
  "title": "Lore v2 status request",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta"],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "params": { "$ref": "#/$defs/params" }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientId", "requestId"],
      "properties": {
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sessionId": { "type": "string", "maxLength": 256 },
        "expectedStoreId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "requiredCapabilities": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedApiMajor": { "type": "integer", "minimum": 1, "maximum": 99 }
      }
    }
  }
}
