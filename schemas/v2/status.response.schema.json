{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lore:v2:status.response",
  "title": "Lore v2 status response",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "requestId", "storeId", "result"],
  "properties": {
    "ok": { "const": true },
    "requestId": { "type": "string", "minLength": 1 },
    "storeId": { "type": "string", "minLength": 1 },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiMajor",
        "apiMinor",
        "daemonVersion",
        "schemaVersion",
        "storeId",
        "processInstanceId",
        "uptimeMs",
        "readiness",
        "capabilities",
        "memoryRevision",
        "derivedGeneration",
        "counts",
        "queue",
        "sources",
        "embedding"
      ],
      "properties": {
        "apiMajor": { "const": 2 },
        "apiMinor": { "type": "integer", "minimum": 0 },
        "daemonVersion": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "storeId": { "type": "string", "minLength": 1 },
        "processInstanceId": { "type": "string", "minLength": 1 },
        "uptimeMs": { "type": "integer", "minimum": 0 },
        "readiness": { "enum": ["ready", "degraded", "unavailable"] },
        "reason": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "memoryRevision": { "type": "string", "pattern": "^[0-9]+$" },
        "derivedGeneration": { "type": "string", "pattern": "^[0-9]+$" },
        "counts": { "$ref": "#/$defs/counts" },
        "queue": { "$ref": "#/$defs/queue" },
        "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovered", "caughtUp", "growing", "unavailable", "ambiguous", "failed", "skipped"],
      "properties": {
        "discovered": { "type": ["integer", "string"] },
        "caughtUp": { "type": ["integer", "string"] },
        "growing": { "type": ["integer", "string"] },
        "unavailable": { "type": ["integer", "string"] },
        "ambiguous": { "type": ["integer", "string"] },
        "failed": { "type": ["integer", "string"] },
        "skipped": { "type": ["integer", "string"] }
      }
    },
    "embedding": { "$ref": "#/$defs/embedding" },
        "sources": { "$ref": "#/$defs/sources" }
      }
    }
  },
  "$defs": {
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovered", "caughtUp", "growing", "unavailable", "ambiguous", "failed", "skipped"],
      "properties": {
        "discovered": { "type": ["integer", "string"] },
        "caughtUp": { "type": ["integer", "string"] },
        "growing": { "type": ["integer", "string"] },
        "unavailable": { "type": ["integer", "string"] },
        "ambiguous": { "type": ["integer", "string"] },
        "failed": { "type": ["integer", "string"] },
        "skipped": { "type": ["integer", "string"] }
      }
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "dimensions",
        "coverageCurrent",
        "coverageEligible",
        "pending",
        "failed"
      ],
      "properties": {
        "provider": { "type": "string" },
        "state": { "enum": ["disabled", "ready", "paused", "invalid"] },
        "dimensions": { "type": "integer", "minimum": 0 },
        "coverageCurrent": { "type": "string", "pattern": "^[0-9]+$" },
        "coverageEligible": { "type": "string", "pattern": "^[0-9]+$" },
        "pending": { "type": "string", "pattern": "^[0-9]+$" },
        "failed": { "type": "string", "pattern": "^[0-9]+$" },
        "oldestPendingMs": { "type": "integer" },
        "lastError": { "type": "string" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeMemories", "forgottenMemories", "receipts"],
      "properties": {
        "activeMemories": { "type": "string", "pattern": "^[0-9]+$" },
        "forgottenMemories": { "type": "string", "pattern": "^[0-9]+$" },
        "receipts": { "type": "string", "pattern": "^[0-9]+$" }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queued", "running"],
      "properties": {
        "queued": { "type": "string", "pattern": "^[0-9]+$" },
        "running": { "type": "string", "pattern": "^[0-9]+$" }
      }
    }
  }
}
