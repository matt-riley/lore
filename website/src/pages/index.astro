---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Archive from "../components/Archive.astro";
import SessionDemo from "../components/SessionDemo.astro";
const guides = [
  { number: "01", label: "Start here", title: "Install Lore", text: "Choose your coding agents in one guided setup.", href: "/guides/setup/" },
  { number: "02", label: "Try it yourself", title: "Meet your memory", text: "Save a note, switch sessions, and find it again.", href: "/playground/" },
  { number: "03", label: "Make it yours", title: "Tune your setup", text: "Explore scopes, local inference, and maintenance.", href: "/guides/configuration/" },
];
---
<Base home>
  <main id="main" class="home-main">
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero-copy">
        <h1 id="hero-heading">A little memory.<br />A lot of continuity.</h1>
        <p>Give Pi a memory that lasts beyond the conversation. Lore keeps useful preferences, decisions, and context on your machine, ready for your next session.</p>
        <div class="hero-actions"><a class="button" href="/guides/setup/">Install Lore</a><a class="text-link" href="/playground/">Try it in your browser</a></div>
        <p class="harness-note">Also using <a href="/guides/getting-started/">Copilot CLI</a>, or <a href="/guides/cli-integrations/">Codex, Claude Code, or Antigravity CLI</a>? Connect them to the same memory.</p>
      </div>
      <Archive />
    </section>
    <section class="guide-directory" aria-label="Explore the documentation">
      {guides.map((guide) => <a class="guide-entry" href={guide.href}>
        <div class="guide-index"><span>{guide.number} /</span><span>{guide.label}</span></div>
        <h2>{guide.title}</h2><p>{guide.text}</p><span class="guide-arrow"><Icon name="arrow" size={26} /></span>
      </a>)}
    </section>
    <section class="home-demonstration" aria-labelledby="home-demo-heading">
      <div class="demo-section-intro"><div><h2 id="home-demo-heading">New session.<br />Familiar ground.</h2><p>Keep a preference in one Pi session. Start another, and ask Lore to bring it back. Try the whole loop here.</p></div><a class="text-link" href="/playground/">Explore all three demonstrations <Icon name="arrow" size={18} /></a></div>
      <SessionDemo />
    </section>
  </main>
</Base>
